{
  "name": "@hugmesh/character-studio",
  "version": "0.2.0-beta.1",
  "description": "VN character-studio — Gaia/Picrew-style layered-2D anthro/furry avatar creator (native-federation remote 'character-studio'). Phase B0 of the VN-character feature.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve character-studio",
    "build": "ng build character-studio",
    "build:character-studio": "ng build character-studio",
    "test": "ng test character-studio --watch=false --browsers=ChromeHeadlessCI",
    "test:watch": "ng test character-studio",
    "gen": "ng-openapi-gen",
    "gen:fetch": "curl -fsS http://localhost:8080/v3/api-docs -o openapi.json && npm run gen",
    "validate:assets": "node tools/validate-assets.mjs",
    "compose:sweep": "node tools/compose-sweep.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/native-federation": "^22.0.0",
    "@angular/animations": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@softarc/native-federation-node": "^3.5.5",
    "dompurify": "^3.4.11",
    "es-module-shims": "^2.8.1",
    "perfect-freehand": "^1.2.3",
    "pixi.js": "^8.19.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.6.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/jasmine": "^5.1.15",
    "ajv": "^8.20.0",
    "jasmine-core": "^5.13.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "karma-junit-reporter": "^2.0.1",
    "ng-openapi-gen": "^0.51.0",
    "ng-packagr": "^22.0.0",
    "typescript": "~6.0.3"
  }
}
